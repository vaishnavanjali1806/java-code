public class program51 {
    public static void main(String[] args) {
        int[] arr = {7, 9, 1, 3, 5};
        int target = 6;
        int i = 0;
        int j = arr.length - 1;

       
        java.util.Arrays.sort(arr);

        boolean found = false; 

        while (i < j) {
            if (arr[i] + arr[j] == target) {
                System.out.println(true);
                found = true;
                break; 
            }
            if (arr[i] + arr[j] > target)
                j--;
            if (arr[i] + arr[j] < target)
                i++;
        }

        if (!found)
            System.out.println(false);
    }
}
